# OutNova Indra Fusion — Variables de entorno
# Copia este archivo como .env y ajusta los valores

# Workers para pipeline ML paralelo
INDRA_WORKERS=2

# Duración máxima de sesión en segundos
MAX_SESSION_SECONDS=300

# Cargar LLM de AURA al inicio (0=lazy, 1=eager)
AURA_LOAD_ON_START=0

# Modelos LLM para AURA
AURA_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
AURA_LLM_FALLBACK=microsoft/Phi-3-mini-4k-instruct

# Modelo Whisper (tiny, base, small, medium, large)
WHISPER_MODEL=base

# Activar DeepFace (0=desactivado por defecto)
USE_DEEPFACE=0

# Activar Wav2Vec2 para análisis emocional
USE_WAV2VEC2=1

# Sample rate de audio
AUDIO_SAMPLE_RATE=16000

# Umbrales de verificación de entorno
MIN_LIGHT_THRESHOLD=40
MAX_NOISE_THRESHOLD=40

# Tamaño máximo de upload en MB
MAX_UPLOAD_SIZE_MB=200

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
